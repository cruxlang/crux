#!/usr/bin/env bash

set -euo pipefail
cd "$(dirname "$0")/.."

cargo test
cargo build --release --target wasm32-unknown-unknown
mkdir -p target/wasm-node-test
wasm-bindgen \
  target/wasm32-unknown-unknown/release/cruxjs.wasm \
  --target nodejs \
  --out-dir target/wasm-node-test \
  --out-name cruxjs
node tests/wasm-node.js target/wasm-node-test/cruxjs.js
